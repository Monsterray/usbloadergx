diff --git a/source/ext2_internal.c b/source/ext2_internal.c
index ddb5f2a..5f940cd 100644
--- a/source/ext2_internal.c
+++ b/source/ext2_internal.c
@@ -67,7 +67,6 @@ int ext2AddDevice (const char *name, void *deviceData)
     const devoptab_t *devoptab_ext2 = ext2GetDevOpTab();
     devoptab_t *dev = NULL;
     char *devname = NULL;
-    int i;
 
     // Sanity check
     if (!name || !deviceData || !devoptab_ext2) {
@@ -91,15 +90,14 @@ int ext2AddDevice (const char *name, void *deviceData)
     dev->name = devname;
     dev->deviceData = deviceData;
 
-    // Add the device to the devoptab table (if there is a free slot)
-    for (i = 0; i < STD_MAX; i++) {
-        if (devoptab_list[i] == devoptab_list[0] && i != 0) {
-            devoptab_list[i] = dev;
-            return 0;
-        }
-    }
+    // Add the device to the devoptab table (if there is a free slot). The slots are not
+    // scanned by hand: unused ones do not all equal slot 0 once something else (the USB
+    // keyboard, for one) has replaced stdin, and the scan then never found a free slot.
+    if (AddDevice(dev) >= 0)
+        return 0;
 
     // If we reach here then there are no free slots in the devoptab table for this device
+    mem_free(dev);
     errno = EADDRNOTAVAIL;
     return -1;
 }
@@ -108,27 +106,17 @@ void ext2RemoveDevice (const char *path)
 {
     const devoptab_t *devoptab = NULL;
     char name[128] = {0};
-    int i;
+    char devname[130];
 
     // Get the device name from the path
     strncpy(name, path, 127);
     strtok(name, ":/");
 
-    // Find and remove the specified device from the devoptab table
-    // NOTE: We do this manually due to a 'bug' in RemoveDevice
-    //       which ignores names with suffixes
-    for (i = 0; i < STD_MAX; i++) {
-        devoptab = devoptab_list[i];
-        if (devoptab && devoptab->name) {
-            if (strcmp(name, devoptab->name) == 0) {
-                devoptab_list[i] = devoptab_list[0];
-                mem_free((devoptab_t*)devoptab);
-                break;
-            }
-        }
-    }
-
-    return;
+    snprintf(devname, sizeof(devname), "%s:", name);
+    devoptab = GetDeviceOpTab(devname);
+    if (devoptab && devoptab->name && strcmp(name, devoptab->name) == 0 &&
+        RemoveDevice(devname) >= 0)
+        mem_free((devoptab_t*)devoptab);
 }
 
 const devoptab_t *ext2GetDevice (const char *path)
@@ -179,7 +167,7 @@ int ext2InitVolume (ext2_vd *vd)
     memset(vd, 0, sizeof(ext2_vd));
 
     // Initialise the volume lock
-    LWP_MutexInit(&vd->lock, false);
+    LWP_MutexInit(&vd->lock, true);
 
     return 0;
 }
