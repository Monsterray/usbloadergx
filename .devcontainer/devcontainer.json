{
    "name": "devkitPPC",
    "build": {
        "dockerfile": "../Dockerfile",
        "context": "..",
        "target": "toolchain"
    },
    "customizations": {
        "vscode": {
            "settings": {
                "workbench.colorTheme": "Default Dark Modern",
                "files.exclude": {
                    "Dockerfile": true
                }
